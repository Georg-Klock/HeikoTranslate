# Generated by xcodegen
*.xcodeproj/
Generated/

# Secrets
HeikoTranslate/Resources/Secrets.plist

# Xcode / Swift
.build/
DerivedData/
*.xcuserstate
xcuserdata/
.DS_Store
logs/

# Never commit an App Store Connect API key
*.p8
ExportOptions.local.plist

# Working material, not work product. Session seed prompts, drafts, notes to
# self, paperwork in progress. This repository is public; the reasoning that
# produced a decision is Georg's, the decision itself belongs in docs/. See
# CLAUDE.md, "What is public, and what is not".
private/

# Local machine config — the paired iPhone's UDID and anything else that
# identifies this particular Mac or phone rather than the project.
Tools/local.env

# Python tool dependencies (Tools/livetest.py). Newer Pythons write a
# self-ignoring .gitignore inside the venv; older ones don't, and thousands
# of untracked files would jam release.sh's clean-tree gate one confusing
# morning. Ignored here, by the repo, on purpose. GitHub #3.
Tools/.venv/

# Heiko's likeness — the icon source art and the photograph it was drawn from.
# Kept on Georg's disk, never uploaded. These are pictures of a real person who
# did not ask to be in a git remote; the only one that ships is the app icon
# itself, in Assets.xcassets, because the app cannot have an icon otherwise.
# Screenshots of the app live in design's SUBFOLDERS and are still tracked —
# this pattern deliberately matches only the top level.
design/*.png
design/*.jpg
design/*.jpeg
Tools/ExportUpload.plist
Tools/ExportOptions.plist
__pycache__/
