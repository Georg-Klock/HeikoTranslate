<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>GEMINI_API_KEY</key>
    <string>REPLACE-ME</string>

    <!-- Optional: where the revoked-key sentence sends a tap (GitHub #9).
         The real value is the unlisted App Store link, which must never be
         committed — an unlisted link in a public repository is not unlisted.
         Omit the key entirely for development builds; the app copes. -->
    <!-- <key>APP_UPDATE_URL</key>
    <string>https://apps.apple.com/…</string> -->

    <!-- Optional, MEASUREMENT BUILDS ONLY (GitHub #135). Writes each turn's
         microphone audio to Documents/turn-audio/ with the app's own verdict
         beside it, so a candidate language decider can be scored on real
         speech with Tools/lid-bench.py.

         It lives here, in the one file that is gitignored, precisely so it
         cannot be switched on by anything committed: a build from a clean
         checkout has no key and captures nothing. Recordings are other
         people's conversations — turn it off and delete them when the
         measurement is done. Nothing uploads them; Tools/pull_logs.sh is the
         only way they move, the same rule the diagnostic log lives by (#8). -->
    <!-- <key>CAPTURE_TURN_AUDIO</key>
    <true/> -->

</dict>
</plist>
