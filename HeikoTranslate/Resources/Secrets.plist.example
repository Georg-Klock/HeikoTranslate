<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>GEMINI_API_KEY</key>
    <string>REPLACE-ME</string>

    <!-- OPTIONAL. If set, the app POSTs its diagnostic log to this HTTPS URL
         when it goes to the background, so nobody has to send it by hand.
         Leave it out and nothing is ever uploaded.

         The log contains the transcript of every conversation — Heiko's
         words AND the words of whoever he was talking to. Tell him before
         switching this on. -->
    <key>DIAGNOSTIC_UPLOAD_URL</key>
    <string>REPLACE-ME</string>
</dict>
</plist>
